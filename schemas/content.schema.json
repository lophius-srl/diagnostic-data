                        "minItems": 1
                      }
                    },
                    "required": [
                      "all"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "any": {
                        "type": "array",
                        "items": {
                          "$ref": "#/definitions/content/properties/levels/items/properties/blockedBy"
                        },
                        "minItems": 1
                      }
                    },
                    "required": [
                      "any"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "not": {
                        "$ref": "#/definitions/content/properties/levels/items/properties/blockedBy"
                      }
                    },
                    "required": [
                      "not"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "fact": {
                        "$ref": "#/definitions/content/properties/settings/properties/hiddenCost/properties/question"
                      }
                    },
                    "required": [
                      "fact"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "q": {
                        "$ref": "#/definitions/content/properties/settings/properties/hiddenCost/properties/question"
                      },
                      "is": {
                        "$ref": "#/definitions/content/properties/settings/properties/hiddenCost/properties/question"
                      },
                      "in": {
                        "type": "array",
                        "items": {
                          "$ref": "#/definitions/content/properties/settings/properties/hiddenCost/properties/question"
                        },
                        "minItems": 1
                      },
                      "has": {
                        "$ref": "#/definitions/content/properties/settings/properties/hiddenCost/properties/question"
                      },
                      "hasAny": {
                        "type": "array",
                        "items": {
                          "$ref": "#/definitions/content/properties/settings/properties/hiddenCost/properties/question"
                        },
                        "minItems": 1
                      },
                      "countAtLeast": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "exclude": {
                        "type": "array",
                        "items": {
                          "$ref": "#/definitions/content/properties/settings/properties/hiddenCost/properties/question"
                        }
                      }
                    },
                    "required": [
                      "q"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "blockedReason": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label",
              "min",
              "summary"
            ],
            "additionalProperties": false
