        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/content/properties/settings/properties/hiddenCost/properties/question"
              },
              "label": {
                "type": "string"
              },
              "technicalLabel": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "id",
              "label",
              "technicalLabel",
              "description",
              "weight"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/content/properties/settings/properties/hiddenCost/properties/question"
              },
              "label": {
                "type": "string"
              },
              "min": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "summary": {
                "type": "string"
              },
              "blockedBy": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "all": {
                        "type": "array",
                        "items": {
                          "$ref": "#/definitions/content/properties/levels/items/properties/blockedBy"
