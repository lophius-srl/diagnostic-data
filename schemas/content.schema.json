            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/content/properties/settings/properties/hiddenCost/properties/question"
              },
              "name": {
                "type": "string"
              },
              "category": {
                "type": "string",
                "enum": [
                  "tableur",
                  "compta",
                  "gestion",
                  "crm",
                  "ecommerce",
                  "caisse",
                  "metier",
                  "externe",
                  "inconnu"
                ]
              },
