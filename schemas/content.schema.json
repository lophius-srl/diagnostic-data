                    "exclusive": {
                      "type": "boolean",
                      "default": false
                    },
                    "tool": {
                      "$ref": "#/definitions/content/properties/settings/properties/hiddenCost/properties/question"
                    }
                  },
                  "required": [
                    "id",
                    "label"
                  ],
                  "additionalProperties": false
                },
                "minItems": 2
              }
            },
            "required": [
              "id",
              "text",
              "type",
              "options"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "feedbacks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/content/properties/settings/properties/hiddenCost/properties/question"
              },
              "after": {
                "$ref": "#/definitions/content/properties/settings/properties/hiddenCost/properties/question"
              },
              "when": {
                "$ref": "#/definitions/content/properties/levels/items/properties/blockedBy"
              },
              "text": {
                "type": "string",
                "minLength": 1
