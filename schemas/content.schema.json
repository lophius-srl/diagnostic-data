{
  "$ref": "#/definitions/content",
  "definitions": {
    "content": {
      "type": "object",
      "properties": {
        "settings": {
          "type": "object",
          "properties": {
            "locale": {
              "type": "string"
            },
            "contentVersion": {
              "type": "string"
            },
            "estimatedMinutes": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "feedbackMinGap": {
              "type": "integer",
              "minimum": 1
            },
            "hiddenCost": {
              "type": "object",
              "properties": {
                "question": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "hoursPerWeek": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  },
                  "propertyNames": {
                    "pattern": "^[a-z][a-z0-9_]*$"
                  }
                },
                "weeksPerYear": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 52
                },
                "defaultHourlyRate": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "roundTo": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "question",
                "hoursPerWeek",
                "weeksPerYear",
                "defaultHourlyRate",
                "roundTo"
              ],
              "additionalProperties": false
            },
            "links": {
              "type": "object",
              "properties": {
                "site": {
                  "type": "string",
                  "format": "uri"
                },
                "contact": {
                  "type": "string"
                },
                "booking": {
                  "type": "string"
                },
                "baseUrl": {
                  "type": "string"
                }
              },
              "required": [
                "site",
                "contact",
                "booking",
                "baseUrl"
              ],
              "additionalProperties": false
            },
            "features": {
              "type": "object",
              "properties": {
                "testimonials": {
                  "type": "boolean"
                },
                "chequesEntreprises": {
                  "type": "boolean"
                },
                "analytics": {
                  "type": "boolean"
                }
              },
              "required": [
                "testimonials",
                "chequesEntreprises",
                "analytics"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "locale",
            "contentVersion",
            "estimatedMinutes",
            "feedbackMinGap",
            "hiddenCost",
            "links",
            "features"
          ],
          "additionalProperties": false
