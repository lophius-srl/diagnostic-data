                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3
                      },
                      "propertyNames": {
                        "pattern": "^[a-z][a-z0-9_]*$"
                      },
                      "default": {}
                    },
                    "facts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/content/properties/settings/properties/hiddenCost/properties/question"
                      },
                      "default": []
