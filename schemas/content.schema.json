        "benchmarks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/content/properties/settings/properties/hiddenCost/properties/question"
              },
              "text": {
                "type": "string"
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "enabled": {
                "type": "boolean",
                "default": false
              }
            },
            "required": [
              "id",
              "text",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "ui": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "settings",
        "dimensions",
        "levels",
        "tools",
        "questions",
        "feedbacks",
        "benchmarks",
        "ui"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
