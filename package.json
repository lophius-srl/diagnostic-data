{
  "name": "diagnostic-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Diagnostic de maturité data en ligne pour PME wallonnes (Lophius)",
  "scripts": {
    "dev": "npm run content && vite",
    "build": "npm run content && tsc --noEmit && tsc -p functions --noEmit && vite build",
    "content": "tsx scripts/build-content.ts",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:full": "npm run build && wrangler d1 migrations apply diagnostic-leads --local && wrangler pages dev dist --port 8788",
    "leads:export": "tsx scripts/export-leads.ts",
    "db:migrate": "wrangler d1 migrations apply diagnostic-leads --remote",
    "report:samples": "tsx scripts/render-sample-reports.ts",
    "lighthouse": "tsx scripts/lighthouse.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "pdfmake": "^0.2.23",
    "preact": "^11.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@eslint/js": "^9.39.5",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/pdfmake": "^0.2.13",
    "axe-core": "^4.14.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.1",
    "lighthouse": "^12.8.2",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6",
    "vitest": "^3.2.7",
    "wrangler": "^4.163.0",
    "yaml": "^2.9.1",
    "zod-to-json-schema": "^3.25.2"
  }
}
